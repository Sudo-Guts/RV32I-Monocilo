        "dmem_inst/ram_inst/Mram_mem_b39_RAMC" BEL
        "dmem_inst/ram_inst/Mram_mem_b39_RAMD" BEL
        "uart0_inst/Mram_rx_fifo_mem1_RAMA" BEL
        "uart0_inst/Mram_rx_fifo_mem1_RAMB" BEL
        "uart0_inst/Mram_rx_fifo_mem1_RAMC" BEL
        "uart0_inst/Mram_rx_fifo_mem1_RAMD" BEL
        "uart0_inst/Mram_rx_fifo_mem2_RAMA" BEL
        "uart0_inst/Mram_rx_fifo_mem2_RAMB" BEL
        "uart0_inst/Mram_rx_fifo_mem2_RAMC" BEL
        "uart0_inst/Mram_rx_fifo_mem2_RAMD";
PIN SP6_BUFIO_INSERT_ML_BUFIO2_0_pins<0> = BEL "SP6_BUFIO_INSERT_ML_BUFIO2_0"
        PINNAME DIVCLK;
PIN clock_manager_inst/gen_clock_dcm.gen_div2.dcm_sp_inst_pins<3> = BEL
        "clock_manager_inst/gen_clock_dcm.gen_div2.dcm_sp_inst" PINNAME CLKIN;
TIMEGRP sys_clk = PIN "SP6_BUFIO_INSERT_ML_BUFIO2_0_pins<0>" PIN
        "clock_manager_inst/gen_clock_dcm.gen_div2.dcm_sp_inst_pins<3>";
TS_sys_clk = PERIOD TIMEGRP "sys_clk" 10 ns HIGH 50%;
TS_clock_manager_inst_gen_clock_dcm_clkdv_dcm = PERIOD TIMEGRP
        "clock_manager_inst_gen_clock_dcm_clkdv_dcm" TS_sys_clk * 2 HIGH 50%;
